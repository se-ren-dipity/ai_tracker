# Copy this file to .env and fill in your values

# DeepSeek API key — get one at https://platform.deepseek.com
# Leave empty to archive RSS and sync Models Table; analysis/research wait for configuration
DEEPSEEK_API_KEY=
# Optional pet assistant model ID; empty reuses the existing deepseek-chat setting.
ASSISTANT_MODEL=

# Path to the SQLite database file (relative to project root)
DB_PATH=data/tracker.db

# Optional HTTP proxy for RSS and Models Table (leave empty for direct access)
COLLECTOR_PROXY=

# Server settings (optional)
HOST=0.0.0.0
PORT=8000

# Admin setup: python -m backend.admin_auth (writes a salted password hash to .env)
ADMIN_PASSWORD_HASH=
# true for HTTPS. false ONLY for local HTTP / SSH tunnel access.
ADMIN_COOKIE_SECURE=true

# Docker publishes on loopback; use a reverse proxy or SSH tunnel for server access.
BIND_ADDRESS=127.0.0.1
WEB_PORT=29011
MCP_READ_TOKEN=
# Optional read-only MCP profile; generate a separate random token (at least 32 characters).
MCP_PORT=29012
# 默认不自动对旧模型/待确认草稿做付费全量复查；管理员手动补查不受影响。
MODEL_AUTO_REVIEW_ENABLED=false
